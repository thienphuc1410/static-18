name = "wooflix-pages"
compatibility_date = "2026-09-13"
pages_build_output_dir = "."

# Pages Functions are in:
# functions/api/[[path]].js
#
# No Worker route is required.
#
# Configure bindings in Cloudflare Pages Dashboard,
# or add your account-specific IDs before using Wrangler:
#
# [[kv_namespaces]]
# binding = "TMDB_CACHE"
# id = "YOUR_KV_NAMESPACE_ID"
#
# [[r2_buckets]]
# binding = "TMDB_IMAGES"
# bucket_name = "YOUR_R2_BUCKET_NAME"
#
# Secrets:
# wrangler pages secret put TMDB_KEY --project-name YOUR_PAGES_PROJECT
# wrangler pages secret put REFRESH_TOKEN --project-name YOUR_PAGES_PROJECT
